# MongoDB
connectDBUsers=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/DB_NAME?retryWrites=true&w=majority

# Security
NODE_ENV=development
TOKEN_SECRET=replace-with-a-long-random-secret
CRON_SECRET=replace-with-a-long-random-secret
TRACKING_JWT_SECRET=replace-with-a-long-random-secret
TRACKING_JWT_TTL=30m

# CORS / Frontend URLs
# Dev (local)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
FRONTEND_URL=http://localhost:5173
FRONTEND_PUBLIC_URL=http://localhost:3000

# Prod (Vercel) example:
# CORS_ALLOWED_ORIGINS=https://tu-frontend.vercel.app,https://www.tudominio.com
# FRONTEND_URL=https://tu-frontend.vercel.app
# FRONTEND_PUBLIC_URL=https://www.tudominio.com

# Optional toggles
CORS_ALLOW_ALL=false
CORS_ALLOW_VERCEL_PREVIEWS=false
ENABLE_FOLLOWUP_CRON=true
REQUIRE_DROPBOX_UPLOADS=true

# SMTP
EMAIL_EMPRESA=you@domain.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@domain.com
SMTP_PASS=app-password
SMTP_FROM=you@domain.com

# Dropbox (optional if REQUIRE_DROPBOX_UPLOADS=false)
DROPBOX_ACCESS_TOKEN=dropbox-access-token
DROPBOX_ROOT_PATH=/kuche-files

# Cloudinary (optional)
CLOUDINARY_CLOUD_NAME=cloud-name
CLOUDINARY_API_KEY=api-key
CLOUDINARY_API_SECRET=api-secret
